syntax = "v1"

type LoginReq {
	SecretKey string `form:"secretKey" validate:"required"`
}

type GetProgressReq {
	TaskId string `path:"taskid" validate:"required"`
}

type Resp {
	Code int         `json:"code"`
	Msg  string      `json:"msg"`
	Data interface{} `json:"data"`
}

type IdReq {
	Id string `path:"id" validate:"required"`
}

type ContainerRestoreReq {
	Filename string `json:"filename" validate:"required"`
}

type DelContainerBackupReq {
	Filename string `form:"filename" validate:"required"`
}

type ContainerRenameReq {
	IdReq
	NewName string `form:"newName" validate:"required"`
}

type RemoveImageReq {
	IdReq
	Force bool `form:"force,default=false"`
}

type ImagePruneReq {
	Kind string `form:"kind,optional"`
}

type ContainerUpdateReq {
	IdReq
	ImageNameAndTag string `form:"imageNameAndTag" validate:"required"`
	ContainerName   string `form:"containerName,optional"`
}

type ComposeProjectCreateReq {
	ProjectName string `json:"projectName" validate:"required"`
	Filename    string `json:"filename" validate:"required"`
	Content     string `json:"content" validate:"required"`
}

type ComposeProjectFileReq {
	ProjectID string `path:"id" validate:"required"`
	Filename  string `path:"filename" validate:"required"`
}

type ComposeProjectFileUpdateReq {
	ProjectID string `path:"id" validate:"required"`
	Filename  string `path:"filename" validate:"required"`
	Content   string `json:"content" validate:"required"`
	Version   string `json:"version,optional"`
}

type ComposeDeployReq {
	ProjectID       string `json:"projectId" validate:"required"`
	Filename        string `json:"filename" validate:"required"`
	ConfirmToken    string `json:"confirmToken,optional"`
	ConfirmWarnings bool   `json:"confirmWarnings,optional"`
	PullImages      bool   `json:"pullImages,optional"`
}

type ComposeProjectValidateReq {
	ProjectID string `json:"projectId" validate:"required"`
	Filename  string `json:"filename" validate:"required"`
	Content   string `json:"content" validate:"required"`
}

type ComposeDeployPreviewReq {
	ProjectID string `json:"projectId" validate:"required"`
	Filename  string `json:"filename" validate:"required"`
}

type ComposeCleanupPreviewReq {
	ProjectID string `json:"projectId" validate:"required"`
}

type ComposeCleanupReq {
	ProjectID    string `json:"projectId" validate:"required"`
	PreviewToken string `json:"previewToken,optional"`
	DeleteDir    bool   `json:"deleteDir,optional"`
	Confirm      bool   `json:"confirm,optional"`
}

type VersionReq {
	Type string `form:"type,optional"`
}

service dockerCopilot {
	@handler webindex
	get /
}

@server (
	prefix: /api
	group:  auth
)
service dockerCopilot {
	@handler Login
	post /auth (LoginReq) returns (Resp)
}

@server (
		prefix: /api
		group:  progress
		jwt:    Auth
	)
	service dockerCopilot {
		@handler ListProgress
		get /progress/list returns (Resp)

		@handler GetProgress
		get /progress/:taskid (GetProgressReq) returns (Resp)
	}

@server (
	prefix: /api
	group:  container
	jwt:    Auth
)
service dockerCopilot {
	@handler containersList
	get /containers returns (Resp)

	@handler start
	post /container/:id/start (IdReq) returns (Resp)

	@handler stop
	post /container/:id/stop (IdReq) returns (Resp)

	@handler restart
	post /container/:id/restart (IdReq) returns (Resp)

	@handler rename
	post /container/:id/rename (ContainerRenameReq) returns (Resp)

@handler update
		post /container/:id/update (ContainerUpdateReq) returns (Resp)

		@handler checkUpdate
		post /containers/check-update returns (Resp)

		@handler updateIgnore
		post /container/:id/update-ignore (IdReq) returns (Resp)

		@handler restoreUpdateIgnore
		delete /container/:id/update-ignore (IdReq) returns (Resp)

		@handler backup
		get /container/backup returns (Resp)

	@handler backup2compose
	get /container/backup2compose returns (Resp)

	@handler listBackups
	get /container/listBackups returns (Resp)

	@handler restore
	post /container/backups/restore (ContainerRestoreReq) returns (Resp)

	@handler delRestore
	delete /container/backups (DelContainerBackupReq) returns (Resp)

	@handler backupSettings
	get /container/backup-settings returns (Resp)

	@handler updateBackupSettings
	put /container/backup-settings returns (Resp)
}

@server (
	prefix: /api
	group:  compose
	jwt:    Auth
)
service dockerCopilot {
	@handler composeProjects
	get /compose/projects returns (Resp)

	@handler composeProjectCreate
	post /compose/projects (ComposeProjectCreateReq) returns (Resp)

	@handler composeProjectFiles
	get /compose/projects/:id/files (ComposeProjectFileReq) returns (Resp)

	@handler composeProjectFile
	get /compose/projects/:id/files/:filename (ComposeProjectFileReq) returns (Resp)

	@handler composeProjectFileUpdate
	put /compose/projects/:id/files/:filename (ComposeProjectFileUpdateReq) returns (Resp)

	@handler composeDeployPreview
	post /compose/projects/:id/deploy/preview (ComposeDeployPreviewReq) returns (Resp)

	@handler composeDeploy
	post /compose/projects/:id/deploy (ComposeDeployReq) returns (Resp)

	@handler composeCleanupPreview
	post /compose/projects/cleanup/preview (ComposeCleanupPreviewReq) returns (Resp)

	@handler composeCleanup
	post /compose/projects/cleanup (ComposeCleanupReq) returns (Resp)

	@handler composeValidate
	post /compose/validate (ComposeProjectValidateReq) returns (Resp)

	@handler ports
	get /ports returns (Resp)
}

@server (
		prefix: /api
		jwt:    Auth
	)
	service dockerCopilot {
		@handler imagesList
		get /images returns (Resp)

		@handler pruneImages
		post /images/prune (ImagePruneReq) returns (Resp)

		@handler remove
		delete /image/:id (RemoveImageReq) returns (Resp)
	}

@server (
	prefix: /api
	group:  version
	jwt:    Auth
)
service dockerCopilot {
	@handler version
	get /version (VersionReq) returns (Resp)

	@handler updateProgram
	put /program returns (Resp)
}

@server (
	prefix: /api/icons
	group:  icons
	jwt:    Auth
)
service dockerCopilot {
	@handler upload
	post / returns (Resp)

	@handler obtain
	get / returns (Resp)

	@handler delete
	delete / returns (Resp)
}
