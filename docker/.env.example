# 复制为 docker/.env 或在 shell 中 export 后使用：
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d
#
# secretKey 必填：登录密钥 + JWT 签名密钥（至少 8 位且不能为纯数字；请换成足够长的随机串）
secretKey=请替换为强密码

# 镜像与容器名
# DOCKER_COPILOT_IMAGE=dockercopilot:latest
# DOCKER_COPILOT_CONTAINER=dockercopilot

# 仅本机访问（默认）。局域网访问可改为 0.0.0.0，并自行做好网络隔离
# DOCKER_BIND_ADDRESS=127.0.0.1
# DOCKER_PORT=12712

# 宿主机 Docker socket
# DOCKER_SOCKET=/var/run/docker.sock

# 数据目录（相对 docker-compose.yml 所在目录 docker/）
# 默认 ../data ../logs ../compose → 仓库根下的 data/ logs/ compose/
# DOCKER_DATA_DIR=../data
# DOCKER_LOG_DIR=../logs
# DOCKER_COMPOSE_DIR=../compose

# 时区
# TZ=Asia/Shanghai

# 可选代理（取消 docker-compose.yml 中对应 environment 注释后生效）
# githubProxy=https://your-github-proxy.example/
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
